# Template nama variabel. Salin ke .env.local lalu isi nilainya di sana.
# File ini tidak boleh berisi nilai asli.

# --- Database (wajib) ---
# DATABASE_URL: koneksi pooler untuk runtime aplikasi.
DATABASE_URL=
# DIRECT_URL: koneksi langsung/session pooler untuk Prisma CLI dan script.
DIRECT_URL=
# Jumlah maksimum koneksi pool pg (opsional, default di kode).
POOL_MAX=

# --- URL aplikasi (wajib di produksi) ---
# Contoh: https://razrbilz.id
APP_URL=
# Nama lama yang masih dibaca sebagai fallback. Isi sama dengan APP_URL bila dipakai.
NEXT_PUBLIC_BASE_URL=

# --- Supabase (wajib) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai server untuk upload gambar produk. Jangan pernah diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Daftar email admin yang diizinkan, dipisah koma. Kosong berarti semua admin ditolak.
ADMIN_EMAILS=

# --- Duitku ---
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_PAYMENT_METHOD=
# sandbox | production
DUITKU_ENVIRONMENT=

# --- PayPal ---
# sandbox: https://api-m.sandbox.paypal.com | live: https://api-m.paypal.com
PAYPAL_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Biteship ---
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=
BITESHIP_ORIGIN_NAME=
BITESHIP_ORIGIN_PHONE=
BITESHIP_ORIGIN_EMAIL=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_NOTE=
BITESHIP_ORIGIN_POSTAL_CODE=
# Kode pos asal pengiriman; dipakai quote kurir domestik.
ORIGIN_POSTAL_CODE=

# --- Email (Resend) ---
RESEND_API_KEY=
# Harus domain yang sudah diverifikasi di Resend.
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_EMAIL_TO=
OWNER_EMAIL_TO=
# Hanya untuk scripts/test-email.ts; tidak dibaca aplikasi.
EMAIL_TEST_TO=

# --- Early access ---
# Minimal 32 karakter, wajib berbeda antar lingkungan.
EARLY_ACCESS_SIGNING_SECRET=
# Opsional; batas pemakaian token early access.
EARLY_ACCESS_TOKEN_MAX_USES=

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-only, dipakai SDK untuk unggah source map. Jangan di-commit.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Script uji destruktif (lokal saja) ---
# Harus bernilai 1 agar scripts/test-webhook.ts dan scripts/test-biteship-webhooks.ts mau jalan.
ALLOW_DESTRUCTIVE_TESTS=

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  price       Int
  category    String
  images      String[]
  isActive    Boolean       @default(true)
  isPreOrder  Boolean       @default(true)
  stock       Int           @default(0)
  weightGrams Int           @default(350)
  // Dimensi kemasan per unit (cm). NULL = belum diukur admin → ongkir hanya
  // pakai berat aktual. Sengaja tidak diberi default palsu: Biteship
  // menjumlahkan volume antar item, jadi angka karangan akan mengubah harga
  // semua produk lama secara diam-diam.
  lengthCm    Int?
  widthCm     Int?
  heightCm    Int?
  createdAt   DateTime      @default(now())
  orderItems  OrderItem[]
  sizes       ProductSize[]
  sizeGuideId String?
  sizeGuide   SizeGuide?    @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
}

model SizeGuide {
  id           String    @id @default(cuid())
  name         String
  description  String?
  measurements Json      @default("{\"columns\":[\"Size\",\"Chest Width\",\"Length\"],\"rows\":[]}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model ProductSize {
  id        String  @id @default(cuid())
  productId String
  size      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  customerName        String
  email               String
  phone               String
  country             String        @default("ID")
  province            String?
  stateProvince       String?
  shippingAddress     String
  apartment           String?
  district            String?
  city                String        @default("")
  postalCode          String        @default("")
  courier             String
  shippingCost        Int
  subtotal            Int
  total               Int
  paymentStatus       String        @default("pending")
  orderStatus         String        @default("processing")
  paidAt              DateTime?
  expiredAt           DateTime?
  stockReturnedAt     DateTime?
  isPreOrder          Boolean       @default(true)
  trackingNumber      String?
  manualCourier       String?
  manualService       String?
  manualShippedAt     DateTime?
  manualTrackingNote  String?
  duitkuReference     String?       @unique
  duitkuPaymentMethod String?
  duitkuPaymentUrl    String?
  duitkuVaNumber      String?
  duitkuQrString      String?
  duitkuPaymentCode   String?
  duitkuFee           String?
  duitkuStatusMessage String?
  // PayPal (orders v2). paypalAmountUsd = string desimal persis ("30.00") agar
  // verifikasi capture exact-match. Kolom lama (total/paymentStatus/createdAt)
  // dipakai ulang; kolom di bawah hanya khusus PayPal.
  paypalOrderId       String?       @unique
  paypalCaptureId     String?
  paypalAmountUsd     String?
  paypalCurrency      String?
  paypalExchangeRate  Float?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  biteshipOrderId     String?
  biteshipTrackingId  String?
  biteshipStatus      String?
  shippingOrderError  String?
  shippingOrderStatus String        @default("PENDING")
  shippingRetryCount  Int           @default(0)
  needsManualReview   Boolean       @default(false)
  priceRegion         String        @default("ID")
  exchangeRate        Float?
  items               OrderItem[]
  shippingLogs        ShippingLog[]
}

model ExchangeRate {
  id         String    @id @default(cuid())
  usdToIdr   Float
  source     String    @default("api")
  isOverride Boolean   @default(false)
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime?
}

model SiteSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

model ShippingLog {
  id            String   @id @default(cuid())
  orderId       String
  event         String
  previousValue String?
  newValue      String?
  note          String?
  rawPayload    String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String?
  size                 String
  quantity             Int
  priceAtBuy           Int
  productNameSnapshot  String?
  productImageSnapshot String?
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Admin {
  id    String @id @default(cuid())
  email String @unique
}

// ── Early Access Gate ────────────────────────────────────────────────────────
// Kolom snake_case (di-mapping eksplisit) karena tabel ini dibuat lewat SQL
// manual, bukan migrate deploy. RLS aktif tanpa policy: hanya role server
// (usebypassrls) yang bisa mengakses, kecuali gate_settings yang punya satu
// policy SELECT untuk anon supaya proxy.ts bisa membaca status di Edge.

model Subscriber {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique
  locale              String    @default("id")
  status              String    @default("pending")
  confirmationTokenHash String? @unique @map("confirmation_token_hash")
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz()
  slotNumber          Int?      @unique @map("slot_number")
  unsubscribedAt      DateTime? @map("unsubscribed_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  accessTokens        AccessToken[]
  emailSends          EmailSend[]

  @@map("subscribers")
}

model EarlyAccessPeriod {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  endedAt   DateTime? @map("ended_at") @db.Timestamptz()
  startedBy String?   @map("started_by")
  accessTokens AccessToken[]
  emailSends   EmailSend[]

  @@map("early_access_periods")
}

model AccessToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriberId String   @map("subscriber_id") @db.Uuid
  periodId     String   @map("period_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()
  useCount     Int      @default(0) @map("use_count")
  maxUses      Int      @default(5) @map("max_uses")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  period       EarlyAccessPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, periodId])
  @@map("access_tokens")
}

model EmailSend {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriberId      String    @map("subscriber_id") @db.Uuid
  periodId          String?   @map("period_id") @db.Uuid
  kind              String
  status            String    @default("pending")
  providerMessageId String?   @map("provider_message_id")
  error             String?
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  subscriber        Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  period            EarlyAccessPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("email_sends")
}

model GateSetting {
  id              Int      @id @default(1)
  status          String   @default("closed")
  currentPeriodId String?  @map("current_period_id") @db.Uuid
  // NULL = tanpa batas. Hanya fungsi SQL confirm_and_assign_slot yang membaca
  // kolom ini; aplikasi tidak pernah memakainya untuk menolak pendaftar.
  earlyAccessCap  Int?     @map("early_access_cap")
  updatedBy       String?  @map("updated_by")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("gate_settings")
}

model GateStatusLog {
  id        Int      @id @default(autoincrement())
  status    String
  periodId  String?  @map("period_id") @db.Uuid
  changedBy String?  @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  @@map("gate_status_log")
}
